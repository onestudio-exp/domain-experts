#!/usr/bin/env bash
# domain-experts setup — register the toolkit skills with Claude Code.
#
# Mirrors the gstack model: the clone IS the install. This script links each
# toolkit skill into ~/.claude/skills/ so Claude Code discovers it as a
# top-level skill (e.g. /domain-creator). On symlink-capable systems the link
# is live — edit the clone, changes take effect immediately. On Windows without
# Developer Mode, ln -s silently copies, so re-run ./setup after edits (or turn
# on Developer Mode for live symlinks).
#
# Usage:
#   ./setup                 register skills into ~/.claude/skills (live if symlinks work)
#   ./setup --prefix        register as domain-experts-<skill> instead of flat <skill>
#   ./setup --local         register into ./.claude/skills (project scope) instead of ~
#   ./setup --link          require live symlinks; fail if the OS can't (Windows Dev Mode off)
#   ./setup --uninstall     remove everything this script installed
#   ./setup --status        show install mode + where skills resolve
#
# Consumer / team path (run from inside ANOTHER project's repo):
#   /path/to/domain-experts/setup team-init [required|optional]
#                           write a committed .claude/settings.json so every
#                           teammate auto-installs the marketplace plugin
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
SKILLS_SRC="$REPO_ROOT/plugins/domain-experts/skills"

if [ ! -d "$SKILLS_SRC" ]; then
  echo "ERROR: run this from the domain-experts repo root (no $SKILLS_SRC)." >&2
  exit 1
fi

# ─── flags ───────────────────────────────────────────────────
PREFIX=""
DEST_BASE="$HOME/.claude"
ACTION="install"
FORCE_LINK=0
TEAM_MODE="required"
for arg in "$@"; do
  case "$arg" in
    team-init)         ACTION="team-init" ;;
    required|optional) TEAM_MODE="$arg" ;;
    --prefix)          PREFIX="domain-experts-" ;;
    --local)           DEST_BASE="$(pwd)/.claude" ;;
    --link)            FORCE_LINK=1 ;;
    --uninstall)       ACTION="uninstall" ;;
    --status)          ACTION="status" ;;
    -h|--help)         sed -n '2,21p' "$0"; exit 0 ;;
    *)                 echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

DEST_SKILLS="$DEST_BASE/skills"
MANIFEST="$DEST_SKILLS/.domain-experts-manifest"

# ─── detect symlink capability once (gstack Windows-fallback rule) ───
detect_symlink() {
  local t; t="$(mktemp -d)"
  echo x > "$t/s"
  ln -s "$t/s" "$t/l" 2>/dev/null
  if [ -L "$t/l" ]; then SYMLINK_OK=1; else SYMLINK_OK=0; fi
  rm -rf "$t"
}

# link the whole skill dir (so SKILL.md + references/ + templates/ all resolve),
# symlink when possible, else copy.
link_or_copy() {
  local src="$1" dst="$2"
  rm -rf "$dst" 2>/dev/null
  if [ "$SYMLINK_OK" -eq 1 ]; then
    ln -s "$src" "$dst"
  else
    cp -R "$src" "$dst"
  fi
}

list_skills() { find "$SKILLS_SRC" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort; }

cmd_install() {
  detect_symlink
  if [ "$FORCE_LINK" -eq 1 ] && [ "$SYMLINK_OK" -eq 0 ]; then
    echo "ERROR: --link requires live symlinks, but this OS can't create them here." >&2
    echo "  Windows: enable Developer Mode (Settings → Privacy & security → For developers)," >&2
    echo "  then re-run. Or drop --link to install in copy mode (re-run ./setup after edits)." >&2
    exit 1
  fi
  mkdir -p "$DEST_SKILLS"
  : > "$MANIFEST"
  local n=0
  while IFS= read -r skill; do
    local name="${PREFIX}${skill}"
    local dst="$DEST_SKILLS/$name"
    link_or_copy "$SKILLS_SRC/$skill" "$dst"
    echo "$name" >> "$MANIFEST"
    n=$((n+1))
    printf "  %-28s %s\n" "/$name" "$([ "$SYMLINK_OK" -eq 1 ] && echo '→ linked (live)' || echo '⇒ copied (re-run after edits)')"
  done < <(list_skills)

  echo ""
  echo "OK — registered $n skill(s) into $DEST_SKILLS"
  if [ "$SYMLINK_OK" -eq 1 ]; then
    echo "Live mode: edit the clone, changes apply on the next Claude Code session."
  else
    echo "Copy mode (Windows without Developer Mode): edits to the clone are NOT live."
    echo "  → turn on Windows Developer Mode for live symlinks, OR re-run ./setup after edits."
  fi
  echo "Update later:  git -C \"$REPO_ROOT\" pull && \"$REPO_ROOT/setup\"${PREFIX:+ --prefix}"
}

cmd_uninstall() {
  if [ ! -f "$MANIFEST" ]; then echo "Nothing to uninstall (no manifest at $MANIFEST)."; exit 0; fi
  local n=0
  while IFS= read -r name; do
    [ -z "$name" ] && continue
    rm -rf "$DEST_SKILLS/$name" && { echo "  removed /$name"; n=$((n+1)); }
  done < "$MANIFEST"
  rm -f "$MANIFEST"
  echo "OK — removed $n skill(s) from $DEST_SKILLS"
}

cmd_status() {
  echo "repo:        $REPO_ROOT"
  echo "commit:      $(git -C "$REPO_ROOT" log -1 --oneline 2>/dev/null || echo '(not a git repo)')"
  echo "dest:        $DEST_SKILLS"
  detect_symlink
  echo "link mode:   $([ "$SYMLINK_OK" -eq 1 ] && echo 'symlink (live)' || echo 'copy (re-run after edits)')"
  echo "installed:"
  if [ -f "$MANIFEST" ]; then sed 's/^/  \//' "$MANIFEST"; else echo "  (none — run ./setup)"; fi
}

# ─── consumer / team provisioning ───────────────────────────
# Writes a committed .claude/settings.json into the CURRENT project (the cwd's
# git repo, NOT this clone) that registers the GitHub marketplace and enables
# the plugin, so anyone who opens + trusts the repo auto-installs the toolkit
# with auto-update. Developers who want live edits use plain ./setup instead.
cmd_team_init() {
  local MARKETPLACE_NAME="domain-experts"
  local MARKETPLACE_REPO="onestudio-exp/domain-experts"
  local PLUGIN_ID="domain-experts@domain-experts"

  local PROJECT_ROOT; PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$PROJECT_ROOT" ]; then
    echo "ERROR: run 'setup team-init' from inside the target project's git repo." >&2
    exit 1
  fi

  local SETTINGS="$PROJECT_ROOT/.claude/settings.json"
  mkdir -p "$PROJECT_ROOT/.claude"

  local DESIRED
  read -r -d '' DESIRED <<JSON || true
{
  "extraKnownMarketplaces": {
    "$MARKETPLACE_NAME": {
      "source": { "source": "github", "repo": "$MARKETPLACE_REPO" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "$PLUGIN_ID": true
  }
}
JSON

  if [ -f "$SETTINGS" ]; then
    echo "NOTE: $SETTINGS already exists."
    echo "Merge these keys into it by hand (don't blindly overwrite a populated settings file):"
    echo "$DESIRED"
    echo ""
    echo "Keys to ensure: extraKnownMarketplaces.$MARKETPLACE_NAME + enabledPlugins.\"$PLUGIN_ID\""
  else
    printf '%s\n' "$DESIRED" > "$SETTINGS"
    echo "Wrote $SETTINGS"
  fi

  echo ""
  echo "Mode: $TEAM_MODE  (teammates are $([ "$TEAM_MODE" = optional ] && echo 'nudged' || echo 'blocked until they install'))"
  echo "Next:"
  echo "  git -C \"$PROJECT_ROOT\" add .claude/settings.json"
  echo "  git -C \"$PROJECT_ROOT\" commit -m 'require domain-experts toolkit'"
  echo ""
  echo "On a teammate's first trusted open of this repo, Claude Code prompts them to"
  echo "add the '$MARKETPLACE_NAME' marketplace and enable the plugin — then auto-updates"
  echo "from $MARKETPLACE_REPO each session. No manual /plugin commands."
}

case "$ACTION" in
  install)   cmd_install ;;
  uninstall) cmd_uninstall ;;
  status)    cmd_status ;;
  team-init) cmd_team_init ;;
esac
