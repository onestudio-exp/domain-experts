#!/usr/bin/env bash
# domain-experts team-init — make a project provision the toolkit for every teammate.
#
# Writes a committed .claude/settings.json into the CURRENT project that registers
# the GitHub marketplace and enables the domain-experts plugin, so anyone who opens
# (and trusts) the repo gets the toolkit auto-installed with auto-update — no manual
# /plugin commands, no vendored files. This is the consumer path (uses the official
# plugin system); developers who want live edits use ./setup from a clone instead.
#
# Usage (run from inside the target project repo):
#   /path/to/domain-experts/bin/team-init          required (block) — default
#   /path/to/domain-experts/bin/team-init optional nudge, don't block
set -uo pipefail

MARKETPLACE_NAME="domain-experts"
MARKETPLACE_REPO="onestudio-exp/domain-experts"
PLUGIN_ID="domain-experts@domain-experts"
MODE="${1:-required}"

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$PROJECT_ROOT" ]; then
  echo "ERROR: run this from inside the project's git repo." >&2
  exit 1
fi

SETTINGS="$PROJECT_ROOT/.claude/settings.json"
mkdir -p "$PROJECT_ROOT/.claude"

# The committed team config. Frozen name + source so future changes never force
# teammates to uninstall/reinstall — edits to this file propagate on next session.
read -r -d '' DESIRED <<JSON || true
{
  "extraKnownMarketplaces": {
    "$MARKETPLACE_NAME": {
      "source": { "source": "github", "repo": "$MARKETPLACE_REPO" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "$PLUGIN_ID": true
  }
}
JSON

if [ -f "$SETTINGS" ]; then
  echo "NOTE: $SETTINGS already exists."
  echo "Merge these keys into it by hand (don't blindly overwrite a populated settings file):"
  echo "$DESIRED"
  echo ""
  echo "Keys to ensure: extraKnownMarketplaces.$MARKETPLACE_NAME + enabledPlugins.\"$PLUGIN_ID\""
else
  printf '%s\n' "$DESIRED" > "$SETTINGS"
  echo "Wrote $SETTINGS"
fi

echo ""
echo "Mode: $MODE  (teammates are $([ "$MODE" = optional ] && echo 'nudged' || echo 'blocked until they install'))"
echo "Next:"
echo "  git -C \"$PROJECT_ROOT\" add .claude/settings.json"
echo "  git -C \"$PROJECT_ROOT\" commit -m 'require domain-experts toolkit'"
echo ""
echo "On a teammate's first trusted open of this repo, Claude Code prompts them to"
echo "add the '$MARKETPLACE_NAME' marketplace and enable the plugin — then auto-updates"
echo "from $MARKETPLACE_REPO each session. No manual /plugin commands."
